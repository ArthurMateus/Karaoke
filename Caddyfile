# Caddy is the single HTTPS entry point. Browsers only allow microphone
# access on https:// pages, so phones on your Wi-Fi need this.
# "tls internal" makes a self-signed certificate: the browser warns once.
{
	auto_https disable_redirects
}

https://localhost:8443, https://{$LAN_IP:127.0.0.1}:8443 {
	tls internal

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /ws/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:5173
	}
}
