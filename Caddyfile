# Caddy is the single entry point in front of the API and the website.
#
# Browsers only allow microphone access on https:// pages, or on localhost.
#  - On this PC:     http://localhost:8080 or http://127.0.0.1:8080 (no certificate warning)
#  - Phones on Wi-Fi: https://<LAN_IP>:8443  ("tls internal" = self-signed
#                     certificate, the browser warns once)
{
	auto_https disable_redirects
}

(app) {
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /ws/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:5173
	}
}

# 127.0.0.1 is a second name for this PC. Browsers keep separate sign-ins per
# name, so it is handy for testing with two players on one PC.
http://localhost:8080, http://127.0.0.1:8080 {
	import app
}

https://localhost:8443, https://{$LAN_IP:127.0.0.1}:8443 {
	tls internal
	import app
}
