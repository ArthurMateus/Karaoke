# The online server's front door (docker-compose.prod.yml): builds the website once
# ("npm run build") and serves the files with Caddy. Local development keeps using
# the Vite dev server (frontend/Dockerfile).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY . .
RUN npm run build

FROM caddy:2.11.7-alpine
COPY --from=build /app/dist /srv
