# Caddy on the online server (docker-compose.prod.yml). The local Caddyfile at the repo
# root is for your PC and is not used here.
#
# - PUBLIC_HOST (from .env) is the site's name, e.g. miccheck-party.duckdns.org.
#   Caddy gets a free Let's Encrypt certificate for it by itself (port 80 must be open)
#   and sends http:// visitors to https://.
# - The website is the built frontend (copied into this image by frontend/Dockerfile.prod).
# - Access logs (they hold IP addresses) go to /data/logs/access.log: a new file every day,
#   files older than 14 days are deleted (the Privacy page promises 14 days).
{
	email {$ACME_EMAIL}
	# Caddy's admin API stays inside the container (used by the healthcheck only).
	admin localhost:2019
	servers {
		# Browsers may use HTTP/3 (QUIC) on 443/udp.
		protocols h1 h2 h3
	}
	# Failed requests (they hold IP addresses too) go to a file with the same
	# 14-day limit instead of Docker's log.
	log errors {
		output file /data/logs/errors.log {
			roll_interval 24h
			roll_keep_for 336h
			roll_size 100MiB
			roll_keep 30
		}
		format filter {
			request>uri query {
				delete token
				delete t
			}
			request>headers>Referer delete
		}
		include http.log.error
	}
	log default {
		exclude http.log.error
	}
}

{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		# Private beta: keep it out of search engines (robots.txt says the same).
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	log {
		output file /data/logs/access.log {
			roll_interval 24h
			roll_keep_for 336h
			roll_size 100MiB
			roll_keep 30
		}
		# Never write sign-in links or stage tokens to the log. Cookies and the
		# Authorization header are left out by Caddy already.
		format filter {
			request>uri query {
				delete token
				delete t
			}
			request>headers>Referer delete
		}
	}

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /ws/* {
		reverse_proxy api:8000
	}
	# Live voice (LiveKit) signalling. The audio itself goes to PUBLIC_IP directly.
	handle /rtc* {
		reverse_proxy livekit:7880
	}

	# The website. Files in /assets have a content hash in their name, so they never
	# change: browsers may keep them for a year. A missing asset is a plain 404.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Everything else: the file if it exists, otherwise index.html (app pages like
	# /room/ABCD). Always checked again, so a new version shows up on the next visit.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
