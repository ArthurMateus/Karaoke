# Copy this file to ".env" and edit it. Every value has a working default,
# so the app also starts without a .env file (but phones won't be able to join).

# Your PC's address on your Wi-Fi network, so phones can open the app.
# Find it with:  ipconfig   (look for "IPv4 Address", e.g. 192.168.0.5)
LAN_IP=127.0.0.1

# The address used in magic-link emails and QR codes.
# For phones, set it to https://<LAN_IP>:8443
PUBLIC_BASE_URL=http://localhost:8080

# Outgoing email. Locally, Mailpit catches everything: open http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=Encore <no-reply@karaoke.local>

# Online lyrics search for uploads (LRCLIB). Leave it out to use lrclib.net, or set it
# empty (LRCLIB_URL=) to turn the search off.
# LRCLIB_URL=https://lrclib.net

# Who may open the Admin page (give premium, make redeem codes). Comma separated emails.
# ADMIN_EMAILS=you@example.com

# --- Private beta ---
# Only these emails (comma separated, any case) may create an account. Leave it empty to let
# anyone sign up (fine on your own PC). Admins (ADMIN_EMAILS) and existing accounts always can.
# Someone not on the list gets a polite "this beta is invite-only" email instead of a link.
# BETA_ALLOWED_EMAILS=friend1@example.com,friend2@example.com

# Who runs the app, shown in the footer and on the Terms and Privacy pages.
# Empty values show "not set yet". The contact email is public on the site.
# OPERATOR_NAME=Your Name
# OPERATOR_CITY=Your City, ST
# CONTACT_EMAIL=contact@example.com
# Where the server and files are hosted, and who delivers the sign-in emails (with the country).
# HOSTING_PROVIDER=Example Cloud, Brazil (Sao Paulo region)
# EMAIL_PROVIDER=Example Mail, United States
# The day the beta ends (YYYY-MM-DD). Empty = "the end date will be announced".
# BETA_END_DATE=2027-01-31
