# Settings for the ONLINE server (docs/DEPLOY.md). Your PC uses .env.example instead.
#
# On the server:  cp .env.production.example .env   (deploy/generate-secrets.sh does it
# for you), then fill in every "CHANGE_ME" and run:  bash deploy/generate-secrets.sh
# .env stays on the server only. Never put real values in this file: the repo is public.
# Values with spaces or <> need "double quotes".

# --- Docker: use the production setup for every "docker compose ..." command ---
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- The site's address ---
# The name people type (no https://, no slash). Caddy gets the HTTPS certificate for it.
# Sign-in links and room QR codes use https://<PUBLIC_HOST>.
PUBLIC_HOST=CHANGE_ME.duckdns.org
# The server's public IP address (Oracle: instance page, "Public IP address").
# LiveKit sends the live voice to this address.
PUBLIC_IP=CHANGE_ME
# Let's Encrypt writes here if the certificate has a problem (it isn't shown on the site).
ACME_EMAIL=CHANGE_ME@example.com

# --- DuckDNS (free name). Token: log in at https://www.duckdns.org, it's at the top. ---
DUCKDNS_TOKEN=CHANGE_ME
# The name before .duckdns.org. Empty = taken from PUBLIC_HOST.
DUCKDNS_SUBDOMAIN=

# --- Sign-in emails (Brevo SMTP) ---
# Brevo: Settings (top right) > "SMTP & API" > SMTP tab. The login looks like
# 1234ab@smtp-brevo.com; the password is an SMTP key you generate there.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# The sender. The address must be verified in Brevo (Senders, domains & IPs).
MAIL_FROM="Mic Check <CHANGE_ME@example.com>"

# --- Who may do what ---
# Admins (comma separated): open the Admin page, always allowed to sign in. Your email.
ADMIN_EMAILS=CHANGE_ME@example.com
# Invite-only: only these emails may create an account (comma separated, any case).
# Add a friend here, then run: docker compose up -d api
BETA_ALLOWED_EMAILS=friend1@example.com,friend2@example.com

# --- Shown in the footer and on the Terms and Privacy pages (public!) ---
OPERATOR_NAME=CHANGE_ME
OPERATOR_CITY="CHANGE_ME, SP"
# Public contact for privacy requests and copyright reports.
CONTACT_EMAIL=CHANGE_ME@example.com
HOSTING_PROVIDER="Oracle Cloud (São Paulo, BR)"
EMAIL_PROVIDER="Brevo (FR, EU)"
# The day the beta ends (YYYY-MM-DD). Empty = "the end date will be announced".
BETA_END_DATE=

# --- Online lyrics search (LRCLIB). Leave it out to use lrclib.net; LRCLIB_URL= turns it off.
# LRCLIB_URL=https://lrclib.net

# --- Backups (deploy/backup.sh). On the same server: see docs/DEPLOY.md. ---
BACKUP_DIR=/var/backups/miccheck
BACKUP_KEEP_DAYS=7

# --- Secrets: filled by deploy/generate-secrets.sh. Leave them empty here. ---
# Never change POSTGRES_PASSWORD after the first start (the database keeps the first one).
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
